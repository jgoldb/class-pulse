# Every variable the code actually reads, and nothing else. `apps/api/src/config.ts` is the
# authoritative loader for the API; the web app reads only the VITE_ prefixed ones.
# Copy to `.env` at the repo root — the API, the Vite dev server, the seed, the evals and the
# Playwright harness all read that one file.

# ---- Database (required) ----
# Neon Postgres. The `production` branch for development; the e2e harness uses its own branch
# and wipes it on every run.
DATABASE_URL=postgresql://user:password@ep-....neon.tech/neondb?sslmode=require
DATABASE_URL_E2E=postgresql://user:password@ep-....neon.tech/neondb?sslmode=require

# ---- Auth: Clerk (required) ----
# `clerk init --app <id>` writes these into apps/web/.env.local; the API reads them from here.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ---- AI: OpenAI (required for generation) ----
OPENAI_API_KEY=
# Optional OpenAI-compatible gateway base URL
OPENAI_BASE_URL=
# Model for plan generation, pattern interpretation and review narration
OPENAI_MODEL=gpt-5.6-terra
# Reasoning effort for the model above: minimal | low | medium | high
OPENAI_REASONING_EFFORT=medium
# Cheaper/faster model for the guardrail classifier and the eval judge. Defaults to OPENAI_MODEL.
OPENAI_CLASSIFIER_MODEL=
OPENAI_CLASSIFIER_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=8000
# Provider posture recorded on every egress log entry
OPENAI_ZERO_RETENTION=true
OPENAI_REGION=us

# ---- App ----
PORT=3001
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
# demonstration = synthetic students only. operational = real students (needs the compliance work in docs/04).
DEPLOYMENT_POSTURE=demonstration
# Roles that may approve plans and decide reviews (open question #7 is district policy)
PLAN_APPROVER_ROLES=teacher,support_professional
# Visible pattern candidates per teacher at once (alert-fatigue cap)
PATTERN_MAX_ACTIVE_PER_TEACHER=3
# Minimum cell size for administrative aggregates
ADMIN_MIN_CELL_SIZE=10
# Cron for the nightly pattern sweep (server local time). Run by the in-process scheduler;
# jobs live in a Postgres-backed queue, so there is no Redis and no separate worker.
PATTERN_SWEEP_CRON=0 2 * * *

# ---- Web dev server (apps/web/vite.config.ts) ----
# Both are dev-only; the production build talks to whatever origin serves it.
WEB_PORT=5173
VITE_API_ORIGIN=http://localhost:3001

# ---- Seed ----
# Password for the seeded Clerk demo accounts. Defaults to ClassPulse-demo-2026! when unset;
# `e2e/fixtures.ts` signs in with the same value.
SEED_PASSWORD=

# ---- Evals (npm run evals) ----
# Evaluate a specific registry seed instead of the active one, e.g. a draft before promotion.
EVAL_PROMPT_VERSION=
# Limit the run to specific case ids, e.g. 001,004. Empty runs every case.
EVAL_CASES=
# EVAL_JUDGE=false skips the LLM judge and reports the deterministic checks only.
EVAL_JUDGE=

# ---- Test-only ----
# Both are honoured only when NODE_ENV=test; every other environment uses OpenAI, including the
# seed and the Playwright harness. The unit suites pass these in directly rather than via .env.
AI_PROVIDER=
MOCK_SCENARIO=
# Set by `npm run e2e:fast` to reuse the existing e2e database instead of reseeding it.
E2E_SKIP_SEED=

# ---- Written by Neon tooling; not read by application code ----
# Left here so a pulled .env does not look like it has drifted from this file.
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
